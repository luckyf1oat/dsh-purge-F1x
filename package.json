{
  "name": "dsh-purge-flash",
  "version": "1.4.0",
  "description": "DSH 破甲插件：token 级重试环 + 十片按需叶子（含邻近交付）+ 分级 prefill + 拒答阶梯 + finish_reason 分流 + 请求体整形。零宿主补丁，172→188 项测试。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-flash": "bin/armor.mjs",
    "dsh-fix-hidden": "bin/fix-hidden.mjs"
  },
  "files": [
    "lib",
    "skill",
    "bin",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node test/selftest.mjs && node test/harness.mjs && node test/rewind.mjs && node test/adapter.mjs && node test/leaf.mjs && node test/retry.mjs && node test/fixhidden.mjs && node tools/lexicon-audit.mjs --strict && node tools/placeholders.mjs --strict",
    "test:all": "npm test && node test/smoke-cordis.mjs",
    "cost": "node bin/armor.mjs cost lib/kernel.js",
    "fix-hidden": "node bin/fix-hidden.mjs --verify",
    "lexicon": "node tools/lexicon-audit.mjs",
    "placeholders": "node tools/placeholders.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "jailbreak",
    "chat",
    "rewind",
    "prompt-injection",
    "prefill",
    "many-shot"
  ],
  "license": "MIT"
}
